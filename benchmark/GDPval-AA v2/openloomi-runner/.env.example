# OpenLoomi server URL (default matches apps/web dev server)
OPENLOOMI_API_URL=http://127.0.0.1:3515

# Optional: path to the bearer token file (default: ~/.openloomi/token)
# OPENLOOMI_TOKEN_PATH=C:\path\to\openloomi-token

# Default model identifier (passed through to the agent runtime)
OPENLOOMI_DEFAULT_MODEL=claude-sonnet-4-5

# Default provider (claude | codex | opencode | hermes | openclaw)
OPENLOOMI_DEFAULT_PROVIDER=claude

# Per-task timeout in ms (default 30 min, matches GDPval-AA v2's generous budget)
GDPVAL_AA_V2_TASK_TIMEOUT_MS=1800000
