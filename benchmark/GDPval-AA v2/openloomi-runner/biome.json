{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": ["src/**/*.ts"],
    "ignore": [
      "scripts/**",
      "**/*.sh",
      "**/*.bat",
      "**/*.ps1",
      ".shims/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}